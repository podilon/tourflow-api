# Copie para .env (ignorado pelo Git). Use apenas valores locais e fictícios.
# Variáveis validadas por src/config/env.ts. No Compose, HOST e PORT do
# serviço api são fixados em 0.0.0.0:3000 dentro do container.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# PostgreSQL local (serviços db e db-test, sem porta publicada no host).
# Opcional: sem esta variável, o Compose usa uma senha local fictícia.
TOURFLOW_DB_PASSWORD=troque-por-uma-senha-local
# DB_HOST, DB_PORT, DB_NAME e DB_USER são fixados pelo Compose no serviço api
# (db:5432/tourflow). Variáveis PG* e DATABASE_URL são rejeitadas pela API.

# Isolamento opcional do Compose (ex.: ensaio em clone limpo ao lado do
# ambiente atual). Sem estas variáveis valem os padrões indicados.
# COMPOSE_PROJECT_NAME=tourflow
# TOURFLOW_API_PORT=3000                              # porta no host (sempre 127.0.0.1)
# TOURFLOW_PGDATA_VOLUME=tourflow_pgdata              # volume do banco de desenvolvimento
# TOURFLOW_NODE_MODULES_VOLUME=tourflow_dev_node_modules
# TOURFLOW_IMAGE_TAG=local                            # tag das imagens tourflow-api e tourflow-dev
